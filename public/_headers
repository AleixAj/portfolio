# Security headers applied to every response by Cloudflare Workers static assets.
# Docs: https://developers.cloudflare.com/workers/static-assets/headers/
#
# CSP notes:
# - 'wasm-unsafe-eval' is required by the meshopt WebAssembly decoder used to load the hero GLB.
# - 'unsafe-inline' in style-src covers React/Framer Motion inline style attributes and Tailwind.
# - style/font origins are Google Fonts; connect-src allows the EmailJS contact API.
# - script-src has no 'unsafe-inline' or external origins: the build ships only one self-hosted module.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self' https://api.emailjs.com; worker-src 'self' blob:; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  Permissions-Policy: camera=(), microphone=(), geolocation=(), browsing-topics=()
  Cross-Origin-Opener-Policy: same-origin
  X-XSS-Protection: 0
