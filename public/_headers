# Security headers applied to every response by Cloudflare Workers static assets.
# Docs: https://developers.cloudflare.com/workers/static-assets/headers/
#
# CSP notes:
# - 'wasm-unsafe-eval' is required by the meshopt WebAssembly decoder used to load the hero GLB.
# - 'unsafe-inline' in style-src covers React/Framer Motion inline style attributes and Tailwind.
# - style/font origins are Google Fonts; connect-src allows the EmailJS contact API.
# - connect-src also allows blob:/data: because Three.js GLTFLoader fetches the GLB's
#   embedded textures through blob: URLs (without it the 3D model loads untextured/white).
# - script-src has no 'unsafe-inline' or external origins: the build ships only one self-hosted module.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self' https://api.emailjs.com blob: data:; worker-src 'self' blob:; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  Permissions-Policy: camera=(), microphone=(), geolocation=(), browsing-topics=()
  Cross-Origin-Opener-Policy: same-origin
  X-XSS-Protection: 0

# app-ads.txt: crawled by AdMob to verify the Orbex app. No caching, so that
# adding another ad network propagates immediately instead of in 24h.
# Its twin lives in the Orbex-web repo (orbex.aleixaj.com); this copy is here
# because the app-ads.txt spec resolves the developer site's ROOT domain.
/app-ads.txt
  Cache-Control: public, max-age=0, must-revalidate
  Content-Type: text/plain
